.page {
  padding-top: 24rpx;
}

.hero {
  padding: 0 32rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #7A4BB5;
}

.hero-sub {
  font-size: 26rpx;
  color: #B89BD6;
  margin-top: 8rpx;
}

.plan-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
}

.role-tag {
  position: absolute;
  top: -14rpx;
  left: 20rpx;
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  font-weight: 600;
}

.plan-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.plan-img-emoji {
  background: linear-gradient(135deg, #F6ECFF, #FFEFF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A3B5A;
}

.plan-meta {
  font-size: 22rpx;
  color: #B89BD6;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan-add {
  flex-shrink: 0;
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 30rpx;
  padding: 12rpx 26rpx;
}

.plan-added {
  background: #F3E9FB;
  color: #8A5BB8;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
}
