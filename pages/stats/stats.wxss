.page {
  padding-top: 24rpx;
}

.hero {
  padding: 0 32rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #7A4BB5;
}

.hero-sub {
  font-size: 26rpx;
  color: #B89BD6;
  margin-top: 8rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 24rpx;
}

.stat-card {
  width: calc(50% - 30rpx);
  margin: 0;
  text-align: center;
  padding: 36rpx 16rpx;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #9B59B6;
}

.stat-label {
  font-size: 24rpx;
  color: #9B86B8;
  margin-top: 8rpx;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3B5A;
}

.chart {
  position: relative;
  height: 260px;
  margin-top: 10rpx;
}

.seg {
  position: absolute;
  height: 4px;
  background: linear-gradient(90deg, #C77DFF, #9B59B6);
  border-radius: 2px;
  transform-origin: left center;
}

.dot {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #FFFFFF;
  border: 4px solid #9B59B6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot-num {
  font-size: 14px;
  color: #7A4BB5;
  font-weight: 700;
  margin-top: -30px;
  width: 40px;
  text-align: center;
}

.x-label {
  position: absolute;
  font-size: 20rpx;
  color: #B8A3D9;
  text-align: center;
  width: 56px;
}

.top-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
}

.top-num {
  font-size: 36rpx;
  width: 56rpx;
  text-align: center;
}

.top-bar-wrap {
  flex: 1;
  background: #F3E9FB;
  border-radius: 14rpx;
  height: 34rpx;
  overflow: hidden;
}

.top-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF9ECD, #F06292);
  border-radius: 14rpx;
  transition: width 0.3s;
}

.top-name {
  width: 220rpx;
  font-size: 26rpx;
  color: #4A3B5A;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.last-meal {
  font-size: 30rpx;
  font-weight: 700;
  color: #D46A9C;
}
