.page {
  padding-top: 24rpx;
}

.hero {
  padding: 0 32rpx 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #7A4BB5;
}

.hero-sub {
  font-size: 26rpx;
  color: #B89BD6;
  margin-top: 8rpx;
}

.tab-row {
  display: flex;
  margin: 0 24rpx 16rpx;
  background: #F3E9FB;
  border-radius: 40rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8A6BA0;
  padding: 14rpx 0;
  border-radius: 34rpx;
  font-weight: 600;
}

.tab-active {
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(155, 89, 182, 0.3);
}

.cuisine-bar {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
}

.cuisine-chip {
  display: inline-block;
  background: #FFFFFF;
  border: 2rpx solid #E8D8F7;
  color: #7A6A90;
  border-radius: 34rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  margin-right: 14rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
}

.dish-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.dish-img-emoji {
  background: linear-gradient(135deg, #F6ECFF, #FFEFF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #4A3B5A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-meta {
  margin-top: 10rpx;
}

.dish-tag {
  display: inline-block;
  background: #F3E9FB;
  color: #8A5BB8;
  font-size: 20rpx;
  border-radius: 18rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
}

.dish-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.dish-btn {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 26rpx;
  padding: 8rpx 20rpx;
}

.dish-enter {
  background: #F3E9FB;
  color: #8A5BB8;
}

.dish-steal {
  background: linear-gradient(135deg, #FF9ECD, #F06292);
  color: #FFFFFF;
}

.dish-fav {
  font-size: 30rpx;
  line-height: 1;
  padding: 4rpx 6rpx;
}

/* 恋爱广场 */
.love-days {
  text-align: center;
  padding: 44rpx 24rpx;
  background: linear-gradient(135deg, #FFF0FA, #F3ECFF);
}

.love-days-label {
  font-size: 26rpx;
  color: #9B86B8;
}

.love-days-num {
  font-size: 100rpx;
  font-weight: 800;
  color: #B06FD9;
  line-height: 1.2;
}

.love-days-unit {
  font-size: 26rpx;
  color: #B89BD6;
}

.quote-card {
  margin: 0 24rpx 16rpx;
  padding: 22rpx 26rpx;
  background: #FFFFFF;
  border: 2rpx solid #F0E3FA;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(155, 89, 182, 0.06);
}

.quote-text {
  font-size: 26rpx;
  color: #7A4BB5;
  line-height: 1.6;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
  margin: 24rpx 0 40rpx;
}

.action-btn {
  flex: 1;
}
