.page {
  padding-top: 20rpx;
}

.head-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 20rpx;
}

.head-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #7A4BB5;
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.dish-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F6ECFF, #FFEFF6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-emoji {
  font-size: 60rpx;
}

.dish-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B5A;
}

.dish-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.dish-ops {
  display: flex;
  gap: 16rpx;
}

.op-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F3E9FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.op-btn.del {
  background: #FFF0F0;
}

.empty-card {
  text-align: center;
  color: #8A6BA0;
  font-size: 28rpx;
  padding: 60rpx 40rpx;
}
