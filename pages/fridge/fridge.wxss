.page {
  padding-top: 20rpx;
}

.hint {
  background: linear-gradient(135deg, #F3E8FF, #FFEFF6);
  border-color: #E0C8FF;
}

.hint-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #7A4BB5;
}

.hint-sub {
  font-size: 24rpx;
  color: #9B86B8;
  margin-top: 8rpx;
}

.result-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #8A6BA0;
}

.clear-btn {
  color: #E0659C;
  font-weight: 600;
  padding: 6rpx 16rpx;
}

/* 冰箱面板 */
.fridge-box {
  margin: 0 24rpx 20rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #F6F0FF, #F3F9FF);
  border: 2rpx solid #E4D6F7;
  border-radius: 24rpx;
}

.fridge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.fridge-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #7A4BB5;
}

.fridge-clear {
  font-size: 24rpx;
  color: #E0659C;
  font-weight: 600;
  padding: 6rpx 12rpx;
}

.fridge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.fridge-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8D8F7;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
}

.fridge-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3B5A;
}

.fridge-days {
  font-size: 22rpx;
  font-weight: 600;
}

.fridge-fresh {
  color: #4CAF7D;
}

.fridge-soon {
  color: #E8973C;
}

.fridge-expired {
  color: #E57373;
}

.fridge-del {
  color: #D9C3F0;
  font-size: 22rpx;
  padding-left: 4rpx;
}

.cards {
  padding: 0 24rpx;
}
