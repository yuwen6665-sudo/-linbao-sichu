.page {
  padding-top: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field.half {
  flex: 1;
}

.label {
  font-size: 26rpx;
  color: #8A6BA0;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.picker-value {
  background: #FBF7FF;
  border: 2rpx solid #E8D8F7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #4A3B5A;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.emoji-item {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: #FBF7FF;
  border: 2rpx solid #F0E3FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.emoji-active {
  background: #F3E9FB;
  border-color: #9B59B6;
  box-shadow: 0 0 0 4rpx rgba(155, 89, 182, 0.15);
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.add-link {
  font-size: 26rpx;
  color: #9B59B6;
  font-weight: 600;
  padding: 8rpx;
}

.img-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pick-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
}

.img-pick {
  width: 160rpx;
  height: 160rpx;
  border: 3rpx dashed #C9A9E8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9B59B6;
  font-size: 26rpx;
  text-align: center;
}

.img-del {
  font-size: 24rpx;
  color: #E57373;
}

.ing-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ing-name-input {
  flex: 2;
}

.ing-amount-input {
  flex: 1;
}

.del-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF0F0;
  color: #E57373;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.step-text {
  flex: 1;
  min-height: 100rpx;
}

.save-btn {
  margin: 10rpx 24rpx 40rpx;
}
