.page {
  padding-top: 24rpx;
}

.hero {
  padding: 0 32rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #7A4BB5;
}

.hero-sub {
  font-size: 26rpx;
  color: #B89BD6;
  margin-top: 8rpx;
}

.total-card {
  text-align: center;
  padding: 44rpx 24rpx;
  background: linear-gradient(135deg, #FFF0FA, #F3ECFF);
}

.total-num {
  font-size: 88rpx;
  font-weight: 800;
  color: #B06FD9;
  line-height: 1.1;
}

.total-label {
  font-size: 26rpx;
  color: #9B86B8;
  margin-top: 10rpx;
}

.total-sub {
  font-size: 24rpx;
  color: #B89BD6;
  margin-top: 12rpx;
}

.top-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F6EFFC;
}

.top-item:last-child {
  border-bottom: none;
}

.top-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.top-img-emoji {
  background: linear-gradient(135deg, #F6ECFF, #FFEFF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.top-main {
  flex: 1;
}

.top-name {
  font-size: 26rpx;
  color: #4A3B5A;
  font-weight: 600;
}

.top-bar-wrap {
  margin-top: 8rpx;
  background: #F3E9FB;
  border-radius: 14rpx;
  height: 26rpx;
  overflow: hidden;
}

.top-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF9ECD, #F06292);
  border-radius: 14rpx;
  transition: width 0.3s;
}

.top-kcal {
  font-size: 24rpx;
  color: #9B59B6;
  font-weight: 700;
  flex-shrink: 0;
}

.disclaimer {
  margin: 0 32rpx 20rpx;
  font-size: 22rpx;
  color: #C9B3E0;
  text-align: center;
}
