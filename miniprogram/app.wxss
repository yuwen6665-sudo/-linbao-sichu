/**
 * 淡紫色主题 —— 全局样式
 *
 * 三条守则：
 *  1. 大面积用浅，小面积用深（页面底色很淡，按钮/强调色才深）
 *  2. 不用渐变、不用阴影投影，靠色块和留白分层
 *  3. 淡粉 #E48CB0 只用在「对象」相关的地方，占比不超过一成
 */

page {
  background: #FAF8FF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', Roboto, sans-serif;
  color: #2E2A3D;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100vh;
}

/* ---------- 布局 ---------- */

.container {
  padding: 24rpx;
}

.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-column { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

/* ---------- 卡片 ---------- */

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* ---------- 按钮 ---------- */

/* 主按钮：实心深紫 + 白字 */
.btn-primary {
  background: #6D5ACB;
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1.5;
  text-align: center;
}

.btn-primary::after { border: none; }

.btn-primary[disabled] {
  background: #D6D0F0;
  color: #FFFFFF;
}

/* 次按钮：浅紫底 + 深紫字 */
.btn-secondary {
  background: #EDE9FF;
  color: #6D5ACB;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1.5;
  text-align: center;
}

.btn-secondary::after { border: none; }

/* 幽灵按钮：白底描边 */
.btn-ghost {
  background: #FFFFFF;
  color: #8A85A0;
  border: 2rpx solid #EFECFA;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  border: none;
  line-height: 1.5;
  text-align: center;
}

.btn-ghost::after { border: none; }

/* ---------- 标签 ---------- */

.tag {
  display: inline-block;
  background: #F0EDFF;
  color: #6D5ACB;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
  margin-top: 10rpx;
}

/* ---------- 文字层级 ---------- */

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2E2A3D;
  line-height: 1.3;
}

.page-subtitle {
  font-size: 24rpx;
  color: #8A85A0;
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E2A3D;
}

.text-sub {
  font-size: 24rpx;
  color: #8A85A0;
}

.text-hint {
  font-size: 22rpx;
  color: #B8B3C9;
}

/* ---------- 空状态 ---------- */

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #8A85A0;
  margin-bottom: 40rpx;
  line-height: 1.7;
}

/* ---------- 弹窗 ---------- */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(46, 42, 61, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 48rpx 40rpx 36rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2E2A3D;
  text-align: center;
  margin-bottom: 32rpx;
}

/* ---------- 分隔线 ---------- */

.divider {
  height: 2rpx;
  background: #EFECFA;
  margin: 24rpx 0;
}

/* ---------- 安全区底部留白 ---------- */

.safe-bottom {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
