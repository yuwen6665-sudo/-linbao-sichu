/* 添加/编辑菜品 —— 淡紫主题 */

.edit-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 200rpx;
}

.card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 上传区 */
.upload-area {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: var(--brand-surface);
  overflow: hidden;
}

.preview {
  width: 100%;
  height: 360rpx;
  display: block;
}

.placeholder {
  width: 100%;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ph-icon {
  font-size: 72rpx;
  opacity: 0.6;
}

.ph-text {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 16rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.textarea {
  min-height: 120rpx;
  line-height: 1.6;
}

.input-ph {
  color: var(--ink-3);
}

/* 口味标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  background: var(--brand-surface);
  color: var(--ink-2);
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
}

.tag-item.on {
  background: var(--brand-surface);
  color: var(--brand-strong);
  font-weight: 500;
  border: 2rpx solid var(--brand-strong);
}

/* 提交 */
.submit {
  text-align: center;
}

.submit.disabled {
  background: var(--brand-surface);
}
