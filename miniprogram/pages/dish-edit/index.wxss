/* 添加菜品页面样式 */

/* 上传区域 */
.upload-area {
  width: 100%;
  height: 300rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

/* 表单 */
.form-item {
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
  display: block;
}

.form-input {
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

/* 标签选择 */
.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag-item {
  padding: 10rpx 25rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.tag-item.active {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
}

/* 保存按钮 */
.save-btn {
  margin-top: 40rpx;
  width: 100%;
}
