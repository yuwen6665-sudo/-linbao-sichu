/* 添加/编辑菜品 —— 淡紫主题 */

.edit-page {
  min-height: 100vh;
  background: #FAF8FF;
  padding: 24rpx 24rpx 200rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 上传区 */
.upload-area {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: #F7F5FF;
  overflow: hidden;
}

.preview {
  width: 100%;
  height: 360rpx;
  display: block;
}

.placeholder {
  width: 100%;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ph-icon {
  font-size: 72rpx;
  opacity: 0.6;
}

.ph-text {
  font-size: 26rpx;
  color: #8A85A0;
  margin-top: 16rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6B6680;
  margin-bottom: 14rpx;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  background: #F7F5FF;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #2E2A3D;
}

.textarea {
  min-height: 120rpx;
  line-height: 1.6;
}

.input-ph {
  color: #B8B3C9;
}

/* 口味标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  background: #F7F5FF;
  color: #6B6680;
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
}

.tag-item.on {
  background: #EDE9FF;
  color: #6D5ACB;
  font-weight: 600;
}

/* 提交 */
.submit {
  text-align: center;
}

.submit.disabled {
  background: #D6D0F0;
}
