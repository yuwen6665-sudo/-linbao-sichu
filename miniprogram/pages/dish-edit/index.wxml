<!-- 添加 / 编辑菜品 -->
<view class="edit-page">

  <view class="card">
    <view class="upload-area" bindtap="uploadImage" hover-class="press" hover-start-time="0" hover-stay-time="80">
      <image wx:if="{{form.image}}" class="preview" src="{{form.image}}" mode="aspectFill"></image>
      <view wx:else class="placeholder">
        <text class="ph-icon">📷</text>
        <text class="ph-text">上传菜品图片</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="label">菜名</text>
      <input class="input" placeholder="给这道菜起个名字" placeholder-class="input-ph"
             value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="label">简介</text>
      <textarea class="textarea" placeholder="一句话介绍一下" placeholder-class="input-ph"
                value="{{form.description}}" data-field="description" bindinput="onInput" maxlength="60" />
    </view>

    <view class="form-item">
      <text class="label">分类</text>
      <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
        <view class="picker-value">{{categories[categoryIndex]}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">口味标签</text>
      <view class="tag-list">
        <text
          wx:for="{{tasteOptions}}"
          wx:key="*this"
          class="tag-item {{form.tasteTags.indexOf(item) > -1 ? 'on' : ''}}"
          data-tag="{{item}}"
          bindtap="toggleTag"
         hover-class="press-soft" hover-start-time="0" hover-stay-time="80">{{item}}</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">大概要多久</text>
      <input class="input" placeholder="例如：20分钟" placeholder-class="input-ph"
             value="{{form.cookTime}}" data-field="cookTime" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="label">热量（可以不填）</text>
      <input class="input" type="number" placeholder="大约多少大卡" placeholder-class="input-ph"
             value="{{form.calories}}" data-field="calories" bindinput="onInput" />
    </view>
  </view>

  <view class="btn-primary submit {{submitting ? 'disabled' : ''}}" bindtap="saveDish" hover-class="press" hover-start-time="0" hover-stay-time="80">
    {{submitting ? '保存中…' : '保存'}}
  </view>

</view>
