<!-- 添加/编辑菜品页面 -->
<view class="dish-edit-page container">
  <!-- 菜品图片上传 -->
  <view class="upload-section card">
    <view class="upload-area" bindtap="uploadImage">
      <image wx:if="{{form.imageUrl}}" src="{{form.imageUrl}}" mode="aspectFill" class="upload-preview"></image>
      <view wx:else class="upload-placeholder">
        <view class="upload-icon">📷</view>
        <view class="upload-text">上传菜品图片</view>
      </view>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-section card">
    <!-- 菜名 -->
    <view class="form-item">
      <label class="form-label">菜名</label>
      <input class="form-input" placeholder="给这道菜起个名字" value="{{form.name}}" bindinput="onInputChange" data-field="name" />
    </view>

    <!-- 简介 -->
    <view class="form-item">
      <label class="form-label">简介</label>
      <textarea class="form-textarea" placeholder="简单介绍一下这道菜" value="{{form.description}}" bindinput="onInputChange" data-field="description" />
    </view>

    <!-- 分类 -->
    <view class="form-item">
      <label class="form-label">分类</label>
      <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
        <view class="picker-value">
          {{categories[categoryIndex] || '请选择分类'}}
        </view>
      </picker>
    </view>

    <!-- 口味标签 -->
    <view class="form-item">
      <label class="form-label">口味标签</label>
      <view class="tags-list">
        <view 
          class="tag-item {{form.tasteTags.includes(item) ? 'active' : ''}}"
          wx:for="{{tasteOptions}}" 
          wx:key="*this"
          bindtap="toggleTag"
          data-tag="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 热量 -->
    <view class="form-item">
      <label class="form-label">热量（大卡）</label>
      <input class="form-input" type="number" placeholder="这道菜大概多少大卡" value="{{form.calories}}" bindinput="onInputChange" data-field="calories" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <button class="btn-primary save-btn" bindtap="saveDish">保存菜品</button>
</view>
