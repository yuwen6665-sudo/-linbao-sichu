/* 订单详情页面样式 */

/* 状态卡片 */
.status-card {
  text-align: center;
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, #fff0f5 0%, #f8f0ff 100%);
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #999;
}

/* 信息卡片 */
.info-card {
  margin-bottom: 20rpx;
}

.info-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

/* 菜品清单 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.dish-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
}

.dish-name {
  font-size: 26rpx;
  color: #666;
}

.dish-count {
  font-size: 26rpx;
  color: #ff6b9d;
}

.dish-total {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: right;
  font-size: 26rpx;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 40rpx;
}

.action-buttons button {
  width: 100%;
  margin-bottom: 20rpx;
}
