/* 订单详情页 —— 淡紫主题 */

.detail-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 200rpx;
}

.loading-tip {
  text-align: center;
  padding: 160rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 状态卡片 */
.status-card {
  background: var(--brand-surface);
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.status-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-strong);
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 24rpx;
  color: var(--ink-2);
}

/* 通用卡片 */
.card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  border-left: 6rpx solid var(--brand);
  padding-left: 20rpx;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

/* 菜品 */
.dish-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
}

.dish-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.dish-thumb.empty {
  font-size: 28rpx;
}

.dish-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.dish-count {
  font-size: 26rpx;
  color: var(--ink-2);
}

.dish-total {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--ink-2);
}

.info-value {
  font-size: 26rpx;
  color: var(--ink);
}

/* 评价 */
.stars {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.star {
  font-size: 48rpx;
  color: var(--line-2);
}

.star.on {
  color: var(--brand);
}

.comment-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  min-height: 120rpx;
  line-height: 1.7;
}

.comment-ph {
  color: var(--ink-3);
}

.photo-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.photo-wrap {
  position: relative;
}

.photo,
.photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: var(--line);
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-2);
}

.photo-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--ink);
  color: var(--on-brand);
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-rate {
  margin-top: 32rpx;
  text-align: center;
}

/* 底部操作 */
.bottom-action {
  border: 1rpx solid var(--line);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
}

.btn-wide {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

/* 这次要准备的食材 */
.ing-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.ing-group:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.ing-dish {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand-strong);
  margin-bottom: 10rpx;
}

.ing-times {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-2);
}

.ing-line {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.9;
  padding-left: 10rpx;
}

.ing-tip {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

/* 生成买菜清单图 */
.make-list {
  margin-top: 24rpx;
  text-align: center;
  padding: 20rpx 0;
}

/* 画图用的画布，藏到屏幕外。
   不能用 display:none —— 那样取不到画布节点，画不了。 */
.off-screen-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 750rpx;
  height: 200rpx;
  pointer-events: none;
}
