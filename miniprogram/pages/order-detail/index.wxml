<!-- 订单详情页 -->
<view class="detail-page">

  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>

  <!-- 打不开就把原因留在页面上（别只弹 toast —— 一闪就没，用户只能截一张空白的图来问） -->
  <view wx:elif="{{loadError}}" class="empty-state">
    <image class="illust illust-lg" src="/images/mascot/13-error.jpg" mode="aspectFit"></image>
    <view class="empty-text">{{loadError}}</view>
  </view>

  <block wx:elif="{{order}}">
    <!-- 状态 -->
    <view class="status-card">
      <!-- 有插画就显示插画，没有就退回 emoji。
           「没有」的情况：状态是新增的、STATUS_IMAGE 里还没配 —— 退回 emoji 不会裂图 -->
      <image wx:if="{{statusImage}}" class="illust illust-md" src="{{statusImage}}" mode="aspectFit"></image>
      <view wx:else class="status-emoji">🍳</view>
      <view class="status-title">{{statusText}}</view>
      <view class="status-desc">{{statusDesc}}</view>
    </view>

    <!-- 菜品清单 -->
    <view class="card">
      <view class="card-title">点了什么</view>
      <view class="dish-row" wx:for="{{order.items}}" wx:key="name">
        <image wx:if="{{item.image}}" class="dish-thumb" src="{{item.image}}" mode="aspectFill"></image>
        <view wx:else class="dish-thumb empty">🍽️</view>
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-count">×{{item.count}}</view>
      </view>
      <view class="dish-total">共 {{totalCount}} 份 · 约 {{order.totalCalories}} 大卡</view>
    </view>

    <!-- 这次要准备的食材（只有做饭的人需要） -->
    <view class="card" wx:if="{{isChef && order.ingredientCount > 0}}">
      <view class="card-title">这次要准备的食材</view>

      <view class="ing-group" wx:for="{{order.items}}" wx:for-item="dish" wx:key="name">
        <block wx:if="{{dish.ingredients.length > 0}}">
          <view class="ing-dish">
            {{dish.name}}<text wx:if="{{dish.count > 1}}" class="ing-times"> ×{{dish.count}}</text>
          </view>
          <view class="ing-line" wx:for="{{dish.ingredients}}" wx:for-item="ing" wx:key="*this">· {{ing}}</view>
        </block>
      </view>

      <view class="ing-tip">照着买就行。想看每道菜具体怎么做，点上面的菜名进详情页。</view>
      <view class="btn-secondary make-list" bindtap="makeShoppingList" hover-class="press" hover-start-time="0" hover-stay-time="80">生成买菜清单图</view>
    </view>

    <!-- 信息 -->
    <view class="card">
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{timeText}}</text>
      </view>
      <view wx:if="{{order.remark}}" class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <!-- 评价 -->
    <view wx:if="{{order.status === 'done'}}" class="card">
      <view class="card-title">{{order.rating > 0 ? '你的评价' : '给这顿饭打个分'}}</view>

      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
              class="star {{rating >= item ? 'on' : ''}}"
              data-star="{{item}}" bindtap="setStar" hover-class="press-soft" hover-start-time="0" hover-stay-time="80">★</text>
      </view>

      <textarea
        class="comment-input"
        placeholder="说两句吧（可以不写）"
        placeholder-class="comment-ph"
        value="{{comment}}"
        bindinput="onCommentInput"
        maxlength="200"
      ></textarea>

      <view class="photo-row">
        <view class="photo-wrap" wx:for="{{photos}}" wx:key="*this">
          <image class="photo" src="{{item}}" mode="aspectFill"></image>
          <text class="photo-del" data-index="{{index}}" bindtap="removePhoto" hover-class="press" hover-start-time="0" hover-stay-time="80">×</text>
        </view>
        <view wx:if="{{photos.length < 3}}" class="photo-add" bindtap="choosePhoto" hover-class="press" hover-start-time="0" hover-stay-time="80">＋ 晒图</view>
      </view>

      <view class="btn-primary submit-rate" bindtap="submitRate" hover-class="press" hover-start-time="0" hover-stay-time="80">保存评价</view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-action" wx:if="{{order.status === 'pending' || order.status === 'making'}}">
      <block wx:if="{{isChef}}">
        <!-- 待接单：接单 + 拒绝 并排。
             列表页早就能拒单了，详情页以前只能接 —— 从详情点进来想拒还得退回列表，很别扭。 -->
        <view wx:if="{{order.status === 'pending'}}" class="act-row">
          <view class="btn-primary" data-action="accept" bindtap="changeStatus" hover-class="press" hover-start-time="0" hover-stay-time="80">接单，开始做</view>
          <view class="btn-secondary" bindtap="rejectOrder" hover-class="press" hover-start-time="0" hover-stay-time="80">今天做不了</view>
        </view>
        <view wx:else class="btn-primary btn-wide"
              data-action="finish" bindtap="changeStatus" hover-class="press" hover-start-time="0" hover-stay-time="80">做好了</view>
      </block>
      <block wx:elif="{{order.status === 'pending' && fromMe}}">
        <view class="btn-secondary btn-wide" bindtap="cancelOrder" hover-class="press" hover-start-time="0" hover-stay-time="80">取消这一单</view>
      </block>
    </view>
  </block>

  <!-- 生成买菜清单图用的画布。藏在屏幕外（不能用 display:none，那样取不到画布节点） -->
  <canvas type="2d" id="listCanvas" class="off-screen-canvas"></canvas>

</view>
