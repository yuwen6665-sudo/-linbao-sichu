<!-- 发现页 —— 心情日历 + 恋爱日志 -->
<view class="discover-page">

  <!-- 顶部：心情日历（窄条） -->
  <view class="mood-card">
    <view class="mood-head">
      <text class="mood-arrow" bindtap="prevMonth">‹</text>
      <text class="mood-month">{{monthLabel}}</text>
      <text class="mood-arrow" bindtap="nextMonth">›</text>
    </view>

    <view class="week-row">
      <text class="week-cell" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="day-grid">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="day-cell {{item.dateStr === todayStr ? 'today' : ''}} {{item.empty ? 'empty' : ''}}"
        data-cell="{{item}}"
        bindtap="onPickDay"
      >
        <block wx:if="{{!item.empty}}">
          <text class="day-num">{{item.day}}</text>
          <text class="day-mood">{{item.moodEmoji}}</text>
        </block>
      </view>
    </view>

    <view class="mood-hint">点某天，记下那天的心情</view>
  </view>

  <!-- 写日志 -->
  <view class="compose-card" wx:if="{{!composing}}" bindtap="toggleCompose">
    <text class="compose-placeholder">今天有什么想记下来的吗？</text>
    <text class="compose-pen">✏️</text>
  </view>

  <view class="compose-card open" wx:else>
    <textarea
      class="compose-input"
      placeholder="今天吃了什么、去哪了、心情怎么样…"
      placeholder-class="compose-ph"
      value="{{draft}}"
      bindinput="onDraftInput"
      maxlength="500"
      auto-focus
    ></textarea>

    <!-- 选个心情 -->
    <view class="draft-moods">
      <text
        wx:for="{{moods}}"
        wx:key="key"
        class="draft-mood {{draftMood === item.key ? 'on' : ''}}"
        data-mood="{{item.key}}"
        bindtap="pickDraftMood"
      >{{item.emoji}}</text>
    </view>

    <!-- 配图 -->
    <view class="draft-images">
      <view class="img-wrap" wx:for="{{draftImages}}" wx:key="*this">
        <image class="img-item" src="{{item}}" mode="aspectFill"></image>
        <text class="img-del" data-index="{{index}}" catchtap="removeDraftImage">×</text>
      </view>
      <view wx:if="{{draftImages.length < 6}}" class="img-add" bindtap="chooseImage">＋</view>
    </view>

    <view class="compose-btns">
      <text class="compose-cancel" catchtap="toggleCompose">取消</text>
      <view class="compose-submit {{submitting ? 'disabled' : ''}}" catchtap="submitPost">
        {{submitting ? '发布中' : '发布'}}
      </view>
    </view>
  </view>

  <!-- 日志流 -->
  <view class="post-list">
    <view wx:if="{{posts.length === 0 && !loading}}" class="empty-state">
      <view class="empty-icon">📖</view>
      <view class="empty-text">
        {{coupleId ? '还没有写过东西，上面点一下开始第一篇' : '绑定对象之后，这里就是你们两个人的日记本'}}
      </view>
      <view wx:if="{{!coupleId}}" class="btn-primary" bindtap="goToProfile">去绑定</view>
    </view>

    <view class="post-card" wx:for="{{posts}}" wx:key="_id">
      <view class="post-head">
        <image wx:if="{{item.avatarUrl}}" class="post-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="post-avatar default">{{item.nickName[0] || '我'}}</view>
        <view class="post-who">
          <view class="post-name">{{item.nickName || '我'}}</view>
          <view class="post-time">{{item.timeText}}</view>
        </view>
        <text wx:if="{{item.moodEmoji}}" class="post-mood">{{item.moodEmoji}}</text>
      </view>

      <view wx:if="{{item.content}}" class="post-content">{{item.content}}</view>

      <view wx:if="{{item.images.length > 0}}" class="post-images">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          class="post-img {{item.images.length === 1 ? 'single' : ''}}"
          src="{{img}}"
          mode="aspectFill"
          data-url="{{img}}"
          data-urls="{{item.images}}"
          bindtap="previewImage"
        ></image>
      </view>

      <view class="post-foot">
        <view class="post-like {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" catchtap="onLike">
          {{item.liked ? '💜' : '🤍'}} {{item.likeCount || ''}}
        </view>
        <text wx:if="{{item.isMine}}" class="post-del" data-id="{{item._id}}" catchtap="onRemovePost">删除</text>
      </view>
    </view>
  </view>

  <!-- 选心情弹窗 -->
  <view class="modal-mask" wx:if="{{showMoodPicker}}" bindtap="closeMoodPicker">
    <view class="mood-modal" catchtap="">
      <view class="mood-modal-title">{{selectedDay}} 的心情</view>
      <view class="mood-options">
        <view
          wx:for="{{moods}}"
          wx:key="key"
          class="mood-option"
          data-mood="{{item.key}}"
          bindtap="chooseMood"
        >
          <text class="mood-emoji">{{item.emoji}}</text>
          <text class="mood-label">{{item.label}}</text>
        </view>
      </view>
      <view class="close-text" catchtap="closeMoodPicker">取消</view>
    </view>
  </view>

</view>
