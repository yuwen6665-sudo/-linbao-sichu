/* 发现页面样式 */
.discover-page {
  padding: 20rpx;
}

/* 顶部标题 */
.discover-header {
  text-align: center;
  padding: 30rpx 0;
}

.header-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* Tab切换 */
.tab-switch {
  display: flex;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 45rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
  font-weight: 500;
}

/* 恋爱广场 */
.post-card {
  margin-bottom: 30rpx;
}

.post-user {
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.post-date {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-rating {
  font-size: 24rpx;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.post-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.post-dishes {
  margin-bottom: 15rpx;
}

.post-likes {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.post-actions {
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  background: #f5f5f5;
  font-size: 26rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 2.2;
}

.action-btn::after {
  border: none;
}

.like-btn {
  color: #ff6b9d;
}

.steal-btn {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
}

/* 菜谱广场 */
.recipe-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.recipe-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 157, 0.06);
}

.recipe-img {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
}

.recipe-info {
  padding: 20rpx;
}

.recipe-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.recipe-author {
  font-size: 22rpx;
  color: #ff6b9d;
  margin-bottom: 8rpx;
}

.recipe-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.recipe-tags {
  margin-bottom: 15rpx;
}

.recipe-actions {
  gap: 10rpx;
}

.mini-btn {
  flex: 1;
  font-size: 20rpx;
  padding: 0;
  background: #f5f5f5;
  color: #666;
  border-radius: 25rpx;
  border: none;
  line-height: 1.8;
}

.mini-btn::after {
  border: none;
}

.mini-btn.primary {
  background: #ff6b9d;
  color: #fff;
}
