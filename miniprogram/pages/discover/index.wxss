/* 发现页 —— 心情日历 + 恋爱日志 */

.discover-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 80rpx;
}

/* ---------- 心情日历（顶部窄条） ---------- */

.mood-card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 24rpx 20rpx 16rpx;
}

.mood-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 12rpx;
}

.mood-arrow {
  font-size: 36rpx;
  color: var(--ink-3);
  padding: 0 16rpx;
}

.mood-month {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  width: 200rpx;
  text-align: center;
}

.week-row,
.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.week-cell {
  width: 14.28%;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  padding: 6rpx 0;
}

.day-cell {
  width: 14.28%;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.day-cell.empty {
  visibility: hidden;
}

.day-cell.today {
  background: var(--brand-surface);
}

.day-num {
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.2;
}

.day-cell.today .day-num {
  color: var(--brand-strong);
  font-weight: 700;
}

.day-mood {
  font-size: 24rpx;
  line-height: 1.2;
  margin-top: 2rpx;
  height: 28rpx;
}

.mood-hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  padding-top: 8rpx;
}

/* ---------- 写日志 ---------- */

.compose-card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.compose-card.open {
  display: block;
}

.compose-placeholder {
  font-size: 28rpx;
  color: var(--ink-3);
}

.compose-pen {
  font-size: 32rpx;
}

.compose-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 160rpx;
  line-height: 1.7;
}

.compose-ph {
  color: var(--ink-3);
}

.draft-moods {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line);
}

.draft-mood {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.draft-mood.on {
  background: var(--brand-surface);
  border: 2rpx solid var(--brand-strong);
}

.draft-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 20rpx;
}

.img-wrap {
  position: relative;
}

.img-item,
.img-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: var(--line);
}

.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-3);
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--ink);
  color: var(--on-brand);
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compose-btns {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
}

.compose-cancel {
  font-size: 26rpx;
  color: var(--ink-2);
}

.compose-submit {
  background: var(--brand-strong);
  color: var(--on-brand);
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
}

.compose-submit.disabled {
  background: var(--brand-surface);
}

/* ---------- 日志流 ---------- */

.post-list {
  margin-top: 24rpx;
}

.post-card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-surface);
  color: var(--brand-strong);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.post-who {
  flex: 1;
}

.post-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.post-time {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

.post-mood {
  font-size: 36rpx;
}

.post-content {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.75;
  margin: 20rpx 0 0;
  white-space: pre-wrap;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.post-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--line);
}

.post-img.single {
  width: 400rpx;
  height: 400rpx;
}

.post-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
}

.post-like {
  font-size: 26rpx;
  color: var(--ink-2);
}

.post-like.liked {
  color: var(--brand-strong);
}

.post-del {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------- 选心情弹窗 ---------- */

.mood-modal {
  width: 620rpx;
  background: var(--card);
  border-radius: 36rpx;
  padding: 44rpx 40rpx 32rpx;
  text-align: center;
}

.mood-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 36rpx;
}

.mood-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.mood-option {
  width: 30%;
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mood-emoji {
  font-size: 48rpx;
}

.mood-label {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}
