/* 首页 —— 淡紫主题 */

.home-page {
  min-height: 100vh;
  background: #FAF8FF;
  padding: 24rpx 24rpx 160rpx;
}

/* 在一起天数卡片 */
.couple-card {
  background: #EDE9FF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.couple-label {
  font-size: 26rpx;
  color: #6D5ACB;
  opacity: 0.75;
}

.couple-days {
  margin: 16rpx 0 8rpx;
}

.days-number {
  font-size: 96rpx;
  font-weight: 800;
  color: #6D5ACB;
  line-height: 1;
}

.days-unit {
  font-size: 30rpx;
  color: #6D5ACB;
  margin-left: 12rpx;
}

.couple-date {
  font-size: 24rpx;
  color: #8A85A0;
}

.set-tip {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  color: #6D5ACB;
  border-radius: 32rpx;
  font-size: 24rpx;
}

/* 打卡 */
.checkin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.checkin-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E2A3D;
}

.checkin-desc {
  font-size: 22rpx;
  color: #8A85A0;
  margin-top: 8rpx;
}

.btn-checkin {
  background: #6D5ACB;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 44rpx;
  border-radius: 40rpx;
}

.btn-checkin.checked {
  background: #F4F1FF;
  color: #8A85A0;
}

/* 两个入口 */
.entry-row {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.entry-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.entry-icon {
  font-size: 44rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2A3D;
}

.entry-desc {
  font-size: 20rpx;
  color: #8A85A0;
  margin-top: 4rpx;
}

/* 四个小工具 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 16rpx;
  margin-top: 24rpx;
}

.quick-item {
  text-align: center;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  background: #F4F1FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin: 0 auto 12rpx;
}

.quick-name {
  font-size: 22rpx;
  color: #6B6680;
}

/* 弹窗 */
.wheel-modal {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 44rpx 40rpx 32rpx;
  text-align: center;
}

.wheel-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2E2A3D;
  margin-bottom: 32rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-flex {
  flex: 1;
  text-align: center;
}

.close-text {
  text-align: center;
  font-size: 24rpx;
  color: #B8B3C9;
  margin-top: 24rpx;
}

/* 灵感卡片 */
.inspire-card {
  width: 420rpx;
  margin: 0 auto;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  border: 6rpx solid transparent;
}

.inspire-card.locked {
  border-color: #6D5ACB;
}

.inspire-img {
  width: 100%;
  height: 320rpx;
  background: #F4F2FB;
  display: block;
}

.inspire-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2E2A3D;
  padding: 20rpx 0 6rpx;
}

.inspire-desc {
  font-size: 24rpx;
  color: #8A85A0;
  padding-bottom: 20rpx;
}

/* 转盘 */
.wheel-container {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin: 0 auto;
}

.wheel-pointer {
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  color: #6D5ACB;
  z-index: 10;
}

.wheel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 10rpx solid #E4B7CC;
  position: relative;
  transition: transform 4s cubic-bezier(0.15, 0.8, 0.25, 1);
  overflow: hidden;
}

.wheel-label {
  position: absolute;
  width: 140rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #2E2A3D;
  left: 50%;
  top: 50%;
}

.label-0 { transform: translate(-50%, -50%) rotate(0deg) translateY(-160rpx); }
.label-1 { transform: translate(-50%, -50%) rotate(60deg) translateY(-160rpx); }
.label-2 { transform: translate(-50%, -50%) rotate(120deg) translateY(-160rpx); }
.label-3 { transform: translate(-50%, -50%) rotate(180deg) translateY(-160rpx); }
.label-4 { transform: translate(-50%, -50%) rotate(240deg) translateY(-160rpx); }
.label-5 { transform: translate(-50%, -50%) rotate(300deg) translateY(-160rpx); }

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #6D5ACB;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  z-index: 10;
}

.wheel-result {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #6D5ACB;
}
