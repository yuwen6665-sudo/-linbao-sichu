/* 我的页面 —— 淡紫主题 */

.profile-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 160rpx;
}

/* 用户卡片 */
.user-card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0 24rpx 0 0;
  background: none;
  border: none;
  line-height: normal;
  width: 128rpx;
}

.avatar-btn::after { border: none; }

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--brand-surface);
  border: 2rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--brand-strong);
  font-weight: 700;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.name-input {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 8rpx 0;
}

.name-ph {
  color: var(--ink-3);
  font-size: 32rpx;
  font-weight: 400;
}

.role-line {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.role-tag {
  background: var(--brand-surface);
  color: var(--brand-strong);
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.switch-role {
  font-size: 22rpx;
  color: var(--brand-strong);
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  border: 2rpx solid var(--brand-border);
  border-radius: 999rpx;
  background: var(--brand-surface);
}

/* 统计 */
.stats-card {
  border: 1rpx solid var(--line);
  display: flex;
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

/* 三格之间加一道竖线。不然三个数字并排会「糊成一坨」，
   眼睛得靠间距自己找边界 —— 有了分隔线，一眼就能看出是「三个指标」。 */
.stat-item + .stat-item {
  border-left: 2rpx solid var(--line);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 6rpx;
}

/* 区块标题 */
/* 左侧加一道品牌色小竖线。整页只有卡片和灰字的话层次太平，
   这道线是页面上唯一的「结构性装饰」，把「我们俩 / 设置」两段分开。 */
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-2);
  margin: 8rpx 0 16rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--brand);
  line-height: 1.3;
}

/* 情侣卡片 */
.couple-card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.member {
  text-align: center;
  width: 220rpx;
}

.member-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--brand-strong);
  color: var(--on-brand);
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.member-avatar.alt {
  /* ⚠️ 别用 --accent-pink(#E48CB0) 打底配白字 —— 那粉色太浅，白字压不住，
     远看就是一团粉。--accent-pink-ink(#9B4A70) 是同一个色系里够深的那个，
     白字上去对比度约 5.9:1，才算读得清。 */
  background: var(--accent-pink-ink);
}

.member-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 6rpx;
}

/* 中间那颗心：给它一个粉色小圆底，做成「徽章」。
   光秃秃一个 ♥ 字符夹在两个人中间，像排版事故；加了圆底才像刻意设计的连接符。
   心形本身用深粉，圆底用淡粉 —— 仍然守着「淡粉只用于对象相关」这条。 */
.member-heart {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--accent-pink-soft);
  color: var(--accent-pink-ink);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.unbind-line {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 28rpx;
}

.unbind-tip {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  line-height: 1.7;
}

.btn-mt {
  margin-top: 28rpx;
  text-align: center;
}

/* 设置列表 */
.setting-list {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--line);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-name {
  font-size: 28rpx;
  color: var(--ink);
}

.setting-value {
  font-size: 24rpx;
  color: var(--ink-2);
}

.id-line {
  text-align: center;
  font-size: 20rpx;
  color: var(--line-2);
  margin-top: 32rpx;
}

/* 邀请弹窗 */
.invite-modal {
  width: 660rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 36rpx;
  padding: 44rpx 40rpx 32rpx;
}

.invite-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 12rpx;
}

.invite-block {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--line);
}

.invite-subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.invite-desc {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* 已生成邀请码、等 TA 填进来 */
.pending-tip {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  line-height: 1.7;
}

.pending-code {
  margin: 24rpx 0;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: var(--brand-strong);
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 28rpx 0;
}

.pending-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.7;
  text-align: center;
}

/* 卡片 / 弹窗里的主按钮要居中 */
.couple-card .btn-primary,
.invite-block .btn-primary {
  margin-top: 24rpx;
  text-align: center;
  padding: 22rpx 0;
}

.invite-note {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.close-text {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-2);
}

.invite-code {
  margin-top: 16rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  color: var(--brand-strong);
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.code-input {
  margin-top: 16rpx;
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: var(--ink);
}

.code-ph {
  font-size: 26rpx;
  letter-spacing: 0;
  color: var(--ink-3);
}

.accept-btn {
  margin-top: 20rpx;
  text-align: center;
}

/* 点下去给个视觉反馈 —— 之前点了完全没变化，用户以为没反应 */
.tap-hover {
  opacity: 0.7;
}
