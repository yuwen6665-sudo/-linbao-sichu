/* 我的页面样式 */

/* 用户卡片 */
.user-card {
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 20rpx;
}

.user-avatar.chef {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
}

.user-avatar.foodie {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.user-role {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.user-id {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.user-actions {
  gap: 10rpx;
}

.btn-mini {
  font-size: 22rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
  border: none;
  line-height: 1.8;
}

.btn-mini::after {
  border: none;
}

.btn-mini.primary {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
}

/* 统计卡片 */
.stats-grid {
  display: flex;
  margin-bottom: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b9d;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 区块卡片 */
.section-card {
  margin-bottom: 30rpx;
}

.section-left {
  align-items: center;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.section-arrow {
  font-size: 24rpx;
  color: #ff6b9d;
}

/* 区块标题 */
.section-title-block {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin: 30rpx 0 15rpx;
  padding-left: 10rpx;
}

/* 情侣绑定卡片 */
.couple-roles {
  margin-bottom: 20rpx;
}

.role-item {
  text-align: center;
}

.role-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin: 0 auto 10rpx;
}

.role-avatar.chef {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
}

.role-avatar.foodie {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.role-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.role-label {
  font-size: 22rpx;
  color: #999;
}

.bind-time {
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

/* 设置列表 */
.setting-list {
  padding: 0;
}

.setting-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-name {
  font-size: 28rpx;
  color: #333;
}

.setting-value {
  font-size: 24rpx;
  color: #999;
}

.flex-column {
  display: flex;
  flex-direction: column;
}
