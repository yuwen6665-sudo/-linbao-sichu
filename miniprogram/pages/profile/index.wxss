/* 我的页面 —— 淡紫主题 */

.profile-page {
  min-height: 100vh;
  background: #FAF8FF;
  padding: 24rpx 24rpx 160rpx;
}

/* 用户卡片 */
.user-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0 24rpx 0 0;
  background: none;
  border: none;
  line-height: normal;
  width: 128rpx;
}

.avatar-btn::after { border: none; }

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #EDE9FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #6D5ACB;
  font-weight: 700;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.name-input {
  font-size: 38rpx;
  font-weight: 700;
  color: #2E2A3D;
  padding: 8rpx 0;
}

.name-ph {
  color: #B8B3C9;
  font-size: 32rpx;
  font-weight: 400;
}

.role-line {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.role-tag {
  background: #EDE9FF;
  color: #6D5ACB;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.switch-role {
  font-size: 22rpx;
  color: #8A85A0;
  margin-left: 20rpx;
}

/* 统计 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #6D5ACB;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #8A85A0;
  margin-top: 6rpx;
}

/* 区块标题 */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8A85A0;
  margin: 8rpx 0 16rpx;
  padding-left: 8rpx;
}

/* 情侣卡片 */
.couple-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.member {
  text-align: center;
  width: 220rpx;
}

.member-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #6D5ACB;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.member-avatar.alt {
  background: #E4B7CC;
}

.member-name {
  font-size: 28rpx;
  color: #2E2A3D;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  font-size: 22rpx;
  color: #8A85A0;
  margin-top: 6rpx;
}

.member-heart {
  font-size: 40rpx;
  color: #E48CB0;
}

.unbind-line {
  text-align: center;
  font-size: 22rpx;
  color: #B8B3C9;
  margin-top: 28rpx;
}

.unbind-tip {
  font-size: 26rpx;
  color: #8A85A0;
  text-align: center;
  line-height: 1.7;
}

.btn-mt {
  margin-top: 28rpx;
  text-align: center;
}

/* 设置列表 */
.setting-list {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #F4F2FB;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-name {
  font-size: 28rpx;
  color: #2E2A3D;
}

.setting-value {
  font-size: 24rpx;
  color: #8A85A0;
}

.id-line {
  text-align: center;
  font-size: 20rpx;
  color: #C9C4D8;
  margin-top: 32rpx;
}

/* 邀请弹窗 */
.invite-modal {
  width: 660rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 44rpx 40rpx 32rpx;
}

.invite-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2E2A3D;
  text-align: center;
  margin-bottom: 12rpx;
}

.invite-block {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #F4F2FB;
}

.invite-subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2A3D;
  margin-bottom: 12rpx;
}

.invite-desc {
  font-size: 24rpx;
  color: #8A85A0;
  line-height: 1.7;
}

/* 已生成邀请码、等 TA 填进来 */
.pending-tip {
  font-size: 26rpx;
  color: #8A85A0;
  text-align: center;
  line-height: 1.7;
}

.pending-code {
  margin: 24rpx 0;
  text-align: center;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: #6D5ACB;
  background: #F7F5FF;
  border-radius: 20rpx;
  padding: 28rpx 0;
}

.pending-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #B8B3C9;
  line-height: 1.7;
  text-align: center;
}

/* 卡片 / 弹窗里的主按钮要居中 */
.couple-card .btn-primary,
.invite-block .btn-primary {
  margin-top: 24rpx;
  text-align: center;
  padding: 22rpx 0;
}

.invite-note {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F4F2FB;
}

.close-text {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8A85A0;
}

.invite-code {
  margin-top: 16rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  color: #6D5ACB;
  background: #F7F5FF;
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.code-input {
  margin-top: 16rpx;
  background: #F7F5FF;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 34rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: #2E2A3D;
}

.code-ph {
  font-size: 26rpx;
  letter-spacing: 0;
  color: #B8B3C9;
}

.accept-btn {
  margin-top: 20rpx;
  text-align: center;
}
