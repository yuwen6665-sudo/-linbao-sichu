<!-- 我的页面 -->
<view class="profile-page">

  <!-- 用户信息 -->
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar default">{{isChef ? '厨' : '吃'}}</view>
    </button>

    <view class="user-main">
      <input class="name-input" type="nickname" placeholder="点我起个昵称"
             placeholder-class="name-ph" value="{{userInfo.nickName}}" bindblur="onNicknameChange" />
      <view class="role-line">
        <text class="role-tag">{{isChef ? '厨神' : '吃货'}}</text>
        <text class="switch-role" bindtap="switchRole" hover-class="press" hover-start-time="0" hover-stay-time="80">切换身份</text>
      </view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <view class="stat-num">{{daysTogether}}</view>
      <view class="stat-label">在一起（天）</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.dishCount}}</view>
      <view class="stat-label">菜单菜品</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.doneCount}}</view>
      <view class="stat-label">做过的饭</view>
    </view>
  </view>

  <!-- 情侣绑定 -->
  <view class="section-title">我们俩</view>
  <view class="couple-card">

    <!-- 还没绑上的时候放一张「两个人」的插画 —— 比一句干巴巴的说明更能讲清楚绑了是干嘛。
         已经绑上了就不放：那会儿上面已经有两个人的头像了，再塞一张是重复。 -->
    <image wx:if="{{!couple}}" class="illust illust-md" src="/images/mascot/10-paired.png" mode="aspectFit"></image>

    <!-- 状态一：真的绑上了（两个人都在） -->
    <block wx:if="{{couple}}">
      <view class="member-row">
        <view class="member">
          <image wx:if="{{userInfo.avatarUrl}}" class="member-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="member-avatar">{{userInfo.nickName[0] || '我'}}</view>
          <view class="member-name">{{userInfo.nickName || '我'}}</view>
          <view class="member-role">{{meRole === 'chef' ? '厨神' : '吃货'}}</view>
        </view>
        <text class="member-heart">♥</text>
        <view class="member">
          <image wx:if="{{partner.avatarUrl}}" class="member-avatar alt" src="{{partner.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="member-avatar alt">{{partner.nickName[0] || 'TA'}}</view>
          <view class="member-name">{{partner.nickName || '还没起昵称'}}</view>
          <view class="member-role">{{partner.role === 'chef' ? '厨神' : '吃货'}}</view>
        </view>
      </view>
      <view class="unbind-line" bindtap="unbind" hover-class="press" hover-start-time="0" hover-stay-time="80">解除绑定</view>
    </block>

    <!-- 状态二：码已经生成，等 TA 填进来 -->
    <block wx:elif="{{pendingInvite}}">
      <view class="pending-tip">邀请码已经生成，等 TA 填进来</view>
      <view class="pending-code">{{pendingInvite}}</view>
      <view class="btn-primary" bindtap="copyInvite" hover-class="press" hover-start-time="0" hover-stay-time="80">复制邀请码，发给 TA</view>
      <view class="pending-hint">TA 也打开这个小程序 →「我的」→「邀请对象」→ 填这个码，就绑上了</view>
    </block>

    <!-- 状态三：还没生成 -->
    <block wx:else>
      <view class="unbind-tip">还没绑定。绑定后订单、日志才有另一个人参与</view>
      <view class="btn-primary btn-mt" bindtap="invitePartner" hover-class="press" hover-start-time="0" hover-stay-time="80">生成邀请码</view>
    </block>
  </view>

  <!-- 设置 -->
  <view class="section-title">设置</view>
  <view class="setting-list">
    <view class="setting-item" bindtap="goAnniversary" hover-class="press-soft" hover-start-time="0" hover-stay-time="80">
      <text class="setting-name">纪念日</text>
      <text class="setting-value">
        {{anniversary ? anniversary + ' · 第 ' + daysTogether + ' 天' : '设置在一起的日期'}} ›
      </text>
    </view>
    <view class="setting-item" bindtap="invitePartner" hover-class="press-soft" hover-start-time="0" hover-stay-time="80">
      <text class="setting-name">邀请对象</text>
      <text class="setting-value">{{couple ? '已绑定' : (pendingInvite ? '我的邀请码' : '生成邀请码')}} ›</text>
    </view>
    <view class="setting-item" bindtap="openNotify" hover-class="press-soft" hover-start-time="0" hover-stay-time="80">
      <text class="setting-name">买菜提醒</text>
      <text class="setting-value">点一下开启 ›</text>
    </view>
  </view>

  <view class="id-line">ID {{openid}}</view>

  <!-- 邀请弹窗。
       ⚠️ 遮罩不加 bindtap="closeInvite" —— 这是个填码的「操作弹窗」，
       点背景就静默关掉，看起来就像「点了没反应」。要关请用底部「关闭」。（2026-09-19 踩过） -->
  <view class="modal-mask" wx:if="{{showInvite}}">
    <view class="invite-modal">
      <view class="invite-title">把 TA 拉进来</view>

      <!-- ⚠️ 「填码 + 绑定」必须放在弹窗最上面。
           键盘一弹起，弹窗下半部分会被推到看不见的地方 —— 放在下面的话
           「绑定」按钮直接消失，用户点不到，表现就是「点了没反应」。（2026-09-19 踩过） -->
      <view class="invite-block">
        <view class="invite-subtitle">TA 给了你码？填这里</view>
        <!-- bindconfirm + confirm-type="done"：键盘右下角会变成「完成」，
             按一下也能绑定。这样就算「绑定」按钮被键盘挡住，也还有第二条路。（2026-09-19 加）

             cursor-spacing="100" 也是为这件事：它要求「输入框底部离键盘至少 100px」。
             弹窗是垂直居中的，而微信只会保证「正在输入的那个框」不被键盘挡 ——
             框下面的东西它不管。留 100px 出来，「绑定」按钮（约 55px 高）就必然落在键盘上方。
             这两个值别改小。 -->
        <input class="code-input" placeholder="输入 6 位邀请码" placeholder-class="code-ph"
               value="{{inputCode}}" bindinput="onInputCode" bindblur="onInputCode"
               bindconfirm="acceptInvite" confirm-type="done"
               maxlength="6" cursor-spacing="100" />
        <view class="btn-primary accept-btn" bindtap="acceptInvite" hover-class="press">绑定</view>
      </view>

      <view class="invite-block">
        <view class="invite-subtitle">或者：把你的邀请码发给 TA</view>
        <view class="invite-code">{{pendingInvite}}</view>
        <view class="btn-primary" bindtap="copyInvite" hover-class="press" hover-start-time="0" hover-stay-time="80">复制邀请码</view>
        <view class="invite-desc">
          复制以后在微信聊天里粘贴发给 TA。TA 打开小程序 →「我的」→「邀请对象」→ 输入这 6 位 → 点「绑定」，你这边就会自动显示两个人。
        </view>
      </view>

      <view class="invite-desc invite-note">邀请码只能用一次。解绑以后，这个码就作废了，想再绑要重新生成。</view>

      <view class="close-text" catchtap="closeInvite" hover-class="press" hover-start-time="0" hover-stay-time="80">关闭</view>
    </view>
  </view>

</view>
