/* 菜单页 —— 淡紫主题 */

/* 整页不滚：顶栏 + 搜索栏 + 内容区 加起来正好一屏。
   以前 .content-area 写死 1060rpx（比屏幕还高），整页会跟着滚，
   变成「外层整页滚 + 内层两个 scroll-view 也滚」——两套滚动抢手势。
   现在交给 flex 自适应，任何机型都不溢出。 */
.menu-page {
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: 220rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.25;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

.btn-switch {
  background: var(--brand-surface);
  color: var(--brand-strong);
  font-size: 24rpx;
  font-weight: 500;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
}

/* 搜索 */
.search-bar {
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  margin: 8rpx 32rpx 20rpx;
  background: var(--card);
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  flex-shrink: 0;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-3);
}

/* 内容区 */
.content-area {
  display: flex;
  padding: 0 32rpx;
  gap: 20rpx;
  flex: 1;
  /* 关键：flex 子项默认「不肯缩到内容以下」，
     内层 scroll-view 要能滚就必须加这句 min-height: 0 */
  min-height: 0;
}

/* 左侧分类 */
.category-col {
  border: 1rpx solid var(--line);
  width: 176rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 12rpx 0;
  flex-shrink: 0;
}

.category-item {
  padding: 24rpx 16rpx;
  text-align: center;
  margin: 8rpx 12rpx;
  border-radius: 20rpx;
  position: relative;
}

.category-item.active {
  background: var(--brand-surface);
}

/* 选中态：左侧那根紫色竖条 */
.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: var(--brand-strong);
  border-radius: 0 6rpx 6rpx 0;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.category-item.active .cat-name {
  color: var(--brand-strong);
}

.cat-count {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

.category-item.active .cat-count {
  color: var(--brand);
}

/* 右侧菜品 */
.dish-col {
  border: 1rpx solid var(--line);
  flex: 1;
  background: var(--card);
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
}

.loading-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 自检提示：菜加载不出来时，把原因写在页面上 */
.diag-box {
  background: var(--warn-soft);
  border: 2rpx solid var(--warn);
  border-radius: 28rpx;
  padding: 28rpx 26rpx;
  margin: 40rpx 0;
}

.diag-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--warn-ink);
  line-height: 1.5;
}

.diag-hint {
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.7;
  margin-top: 12rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: var(--line);
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.dish-desc {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.dish-tags {
  margin-top: 4rpx;
}

.btn-pick {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--brand-strong);
  color: var(--on-brand);
  font-size: 36rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 厨神端底部 */
.bottom-bar {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
}

.btn-add-dish {
  background: var(--brand-strong);
  color: var(--on-brand);
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  padding: 26rpx 0;
  border-radius: 999rpx;
}

/* 吃货端购物车条 */
.bottom-cart {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
  background: var(--ink);
  border-radius: 999rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-badge {
  width: 68rpx;
  height: 68rpx;
  background: var(--brand);
  color: var(--on-brand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.cart-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--on-brand);
}

.cart-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 4rpx;
}

.btn-submit {
  background: var(--brand);
  color: var(--on-brand);
  font-size: 28rpx;
  font-weight: 500;
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
}

.btn-submit.disabled {
  background: var(--ink-3);
  color: var(--ink-2);
}

/* 已选清单 */
.cart-panel {
  border: 1rpx solid var(--line);
  position: fixed;
  bottom: 210rpx;
  left: 32rpx;
  right: 32rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 24rpx;
  max-height: 420rpx;
  z-index: 20;
}

.cart-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cart-panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.cart-panel-clear {
  font-size: 24rpx;
  color: var(--ink-2);
}

.cart-panel-list {
  max-height: 320rpx;
}

.cart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.cart-row-name {
  font-size: 26rpx;
  color: var(--ink);
}

.cart-row-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-minus {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand-surface);
  color: var(--brand-strong);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-row-count {
  font-size: 28rpx;
  color: var(--ink);
  width: 40rpx;
  text-align: center;
}
