<!-- 菜单页面 -->
<view class="menu-page">
  <!-- 顶部标题栏 -->
  <view class="menu-header">
    <view class="header-left">
      <view class="menu-title">{{isChef ? '厨神菜单' : '吃货点单'}}</view>
      <view class="menu-count">{{dishList.length}} 道{{isChef ? '菜单菜品' : '可点菜品'}}</view>
    </view>
    <button class="btn-switch" bindtap="switchRole">
      {{isChef ? '切到吃货' : '切到厨神'}}
    </button>
  </view>

  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索菜名、分类、口味" />
  </view>

  <view class="menu-content flex">
    <!-- 左侧分类栏 -->
    <view class="category-sidebar">
      <view 
        class="category-item {{activeCategory === item.name ? 'active' : ''}}"
        wx:for="{{categories}}" 
        wx:key="name"
        bindtap="selectCategory"
        data-category="{{item.name}}"
      >
        <view class="cat-name">{{item.name}}</view>
        <view class="cat-count">{{item.count}}</view>
      </view>
    </view>

    <!-- 右侧菜品展示区 -->
    <view class="dish-list">
      <block wx:if="{{filteredDishes.length > 0}}">
        <view class="dish-card" wx:for="{{filteredDishes}}" wx:key="_id">
          <image class="dish-img" src="{{item.imageUrl || '/images/default-dish.png'}}" mode="aspectFill"></image>
          <view class="dish-info">
            <view class="dish-name">{{item.name}}</view>
            <view class="dish-desc">{{item.description}}</view>
            <view class="dish-tags">
              <text class="tag" wx:for="{{item.tasteTags}}" wx:key="*this">{{item}}</text>
            </view>
            <!-- 吃货端加购按钮 -->
            <view wx:if="{{!isChef}}" class="add-cart-btn" bindtap="addToCart" data-dish="{{item}}">
              + 选它
            </view>
          </view>
        </view>
      </block>
      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="empty-icon">🍽️</view>
        <view class="empty-text">
          {{isChef ? '这里还没有菜品，点击下方添加菜品，把你拿手的第一道菜放进菜单。' : '这类菜暂时没有可点菜品，可以换个分类看看，或者请厨神上架新菜。'}}
        </view>
        <button wx:if="{{isChef}}" class="btn-primary" bindtap="addDish">添加第一道菜</button>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <!-- 厨神端操作 -->
    <block wx:if="{{isChef}}">
      <button class="btn-action" bindtap="manageCategory">管理分类</button>
      <button class="btn-action btn-primary" bindtap="addDish">添加菜品</button>
      <button class="btn-action" bindtap="sortDish">菜品排序</button>
    </block>
    <!-- 吃货端购物车 -->
    <block wx:else>
      <view class="cart-info">
        <view class="cart-count">{{cartList.length}}</view>
        <view class="cart-text">还没选菜<br/>选好后提交给厨神</view>
      </view>
      <button class="btn-submit" bindtap="submitOrder" disabled="{{cartList.length === 0}}">提交</button>
    </block>
  </view>
</view>
