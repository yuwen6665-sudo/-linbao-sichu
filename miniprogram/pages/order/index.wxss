/* 订单页 —— 淡紫主题 */

.order-page {
  min-height: 100vh;
  background: #FAF8FF;
  padding: 24rpx 24rpx 160rpx;
}

.loading-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: #B8B3C9;
}

/* 统计 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #6D5ACB;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #8A85A0;
  margin-top: 6rpx;
}

/* Tab */
.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #8A85A0;
  border-radius: 36rpx;
}

.tab.active {
  background: #EDE9FF;
  color: #6D5ACB;
  font-weight: 600;
}

/* 订单卡片 */
.order-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #2E2A3D;
}

.order-time {
  font-size: 22rpx;
  color: #B8B3C9;
  margin-top: 6rpx;
}

.order-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.status-pending { background: #FFF4E5; color: #B3690F; }
.status-making  { background: #EDE9FF; color: #6D5ACB; }
.status-done    { background: #E6F7EE; color: #2E7D51; }
.status-rejected,
.status-canceled { background: #F4F2FB; color: #8A85A0; }

.order-items {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F4F2FB;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.item-name {
  font-size: 26rpx;
  color: #2E2A3D;
}

.item-count {
  font-size: 24rpx;
  color: #8A85A0;
}

.order-remark {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B6680;
  background: #F7F5FF;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.act {
  flex: 1;
  text-align: center;
  background: #6D5ACB;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border-radius: 40rpx;
}

.act.ghost {
  background: #EDE9FF;
  color: #6D5ACB;
}

.act.wide {
  flex: 2;
}

/* 评价 */
.rate-area {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F4F2FB;
}

.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 36rpx;
  color: #E4E0F2;
}

.star.on {
  color: #8B7BE8;
}

.star.pick {
  font-size: 44rpx;
}

.rate-hint {
  font-size: 26rpx;
  color: #8A85A0;
}

.rate-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rate-submit {
  margin-left: 20rpx;
  background: #6D5ACB;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}
