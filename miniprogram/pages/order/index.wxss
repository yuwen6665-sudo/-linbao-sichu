/* 订单页面样式 */

/* 顶部统计 */
.stats-grid {
  display: flex;
  margin-bottom: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b9d;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* Tab切换 */
.order-tabs {
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.order-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 45rpx;
}

.order-tab.active {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
  font-weight: 500;
}

/* 订单卡片 */
.order-card {
  margin-bottom: 20rpx;
}

.order-header {
  margin-bottom: 10rpx;
}

.order-no {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background: #fff3cd;
  color: #856404;
}

.status-making {
  background: #cce5ff;
  color: #004085;
}

.status-done {
  background: #d4edda;
  color: #155724;
}

.order-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.order-items {
  margin-bottom: 20rpx;
}

.order-item {
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}

.order-actions {
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 2;
}

.action-btn::after {
  border: none;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
}
