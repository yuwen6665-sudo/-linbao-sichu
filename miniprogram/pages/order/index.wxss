/* 订单页 —— 淡紫主题 */

.order-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 160rpx;
}

.loading-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 统计 */
.stats-card {
  border: 1rpx solid var(--line);
  display: flex;
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 6rpx;
}

/* Tab */
.tabs {
  border: 1rpx solid var(--line);
  display: flex;
  background: var(--card);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
  border-radius: 999rpx;
}

.tab.active {
  background: var(--brand-surface);
  color: var(--brand-strong);
  font-weight: 500;
}

/* 订单卡片 */
.order-card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}

.order-time {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.order-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.status-pending { background: var(--warn-soft); color: var(--warn-ink); }
.status-making  { background: var(--brand-surface); color: var(--brand-strong); }
.status-done    { background: var(--success-soft); color: var(--success-ink); }
.status-rejected,
.status-canceled { background: var(--line); color: var(--ink-2); }

.order-items {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.item-name {
  font-size: 26rpx;
  color: var(--ink);
}

.item-count {
  font-size: 24rpx;
  color: var(--ink-2);
}

.order-remark {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--brand-surface);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.act {
  flex: 1;
  text-align: center;
  background: var(--brand-strong);
  color: var(--on-brand);
  font-size: 26rpx;
  font-weight: 500;
  padding: 20rpx 0;
  border-radius: 999rpx;
}

.act.ghost {
  background: var(--brand-surface);
  color: var(--brand-strong);
}

.act.wide {
  flex: 2;
}

/* 评价 */
.rate-area {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 36rpx;
  color: var(--line-2);
}

.star.on {
  color: var(--brand);
}

.star.pick {
  font-size: 44rpx;
}

.rate-hint {
  font-size: 26rpx;
  color: var(--ink-2);
}

.rate-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rate-submit {
  margin-left: 20rpx;
  background: var(--brand-strong);
  color: var(--on-brand);
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
}
