/* 菜品详情页 —— 淡紫主题 */

.detail-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 200rpx;
}

.loading-tip {
  text-align: center;
  padding: 160rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 大图 */
.dish-hero {
  margin: 24rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.dish-img {
  width: 100%;
  height: 460rpx;
  border-radius: 32rpx;
  background: var(--brand-surface);
  display: block;
}

/* 卡片 */
.card {
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
}

.dish-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.meta-row {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}

.desc-text {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-top: 20rpx;
  line-height: 1.7;
}

.tags-row {
  margin-top: 16rpx;
}

/* 区块头 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.section-badge {
  font-size: 22rpx;
  color: var(--ink-2);
}

/* 食材 / 步骤 */
.ingredient-item,
.step-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.num-circle {
  width: 44rpx;
  height: 44rpx;
  background: var(--brand-surface);
  color: var(--brand-strong);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.item-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
}

/* 营养 */
.nutrition-row {
  display: flex;
  justify-content: space-around;
}

.nutrition-item {
  text-align: center;
}

.nutrition-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-strong);
}

.nutrition-label {
  font-size: 20rpx;
  color: var(--ink-2);
  margin-top: 6rpx;
}

.benefit-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin: 28rpx 0 12rpx;
}

.benefit-text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

/* 底部 */
.bottom-action {
  border: 1rpx solid var(--line);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
}

.btn-wide {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

/* 小窍门 */
.tip-item {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.tip-bulb {
  font-size: 26rpx;
  margin-right: 12rpx;
  line-height: 1.7;
  flex-shrink: 0;
}

.tip-item .item-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.7;
}
