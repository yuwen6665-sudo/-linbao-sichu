.gcard {
  background: #FFFFFF;
  border-radius: 22rpx;
  overflow: hidden;
  border: 2rpx solid #F0E3FA;
  box-shadow: 0 6rpx 16rpx rgba(155, 89, 182, 0.08);
}

.gimg {
  height: 230rpx;
  background: linear-gradient(135deg, #F6ECFF, #FFEFF6);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gimg-img {
  width: 100%;
  height: 100%;
}

.gimg-emoji {
  font-size: 100rpx;
  line-height: 1;
}

.gfav {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
}

.gfav.dim {
  opacity: 0.4;
}

.gbody {
  padding: 16rpx 18rpx 18rpx;
  position: relative;
  padding-bottom: 70rpx;
}

.gname {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B5A;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.35;
}

.gmeta {
  font-size: 22rpx;
  color: #B8A3D9;
  margin-top: 8rpx;
}

.gdot {
  color: #D8C8EC;
}

.gadd {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
  text-align: center;
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 34rpx;
  padding: 12rpx 0;
}

.gadd-on {
  background: #E8D8F7;
  color: #9B59B6;
}
