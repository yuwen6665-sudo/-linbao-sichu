.dcard {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid #F0E3FA;
  box-shadow: 0 6rpx 18rpx rgba(155, 89, 182, 0.08);
  margin-bottom: 20rpx;
}

.dimg {
  height: 260rpx;
  background: linear-gradient(135deg, #F6ECFF, #FFEFF6);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dimg-img {
  width: 100%;
  height: 100%;
}

.dimg-emoji {
  font-size: 120rpx;
  line-height: 1;
}

.dimg-match {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background: #9B59B6;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 18rpx;
  padding: 4rpx 16rpx;
}

.dbody {
  padding: 18rpx 20rpx 20rpx;
}

.dhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dname {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3B5A;
}

.dfav {
  font-size: 34rpx;
  padding: 4rpx;
}

.dfav.dim {
  opacity: 0.35;
}

.ddesc {
  font-size: 24rpx;
  color: #9B8AAE;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.dtags {
  margin-top: 12rpx;
}

.dfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.dmeta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.dprice {
  font-size: 30rpx;
  font-weight: 700;
  color: #E0659C;
}

.dtime {
  font-size: 22rpx;
  color: #B8A3D9;
}

.dadd {
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 30rpx;
  padding: 10rpx 26rpx;
}

.dadd-on {
  background: #E8D8F7;
  color: #9B59B6;
}

.dreason {
  font-size: 22rpx;
  color: #A86FD6;
  background: #F9F1FF;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  margin: 8rpx 0 4rpx;
  line-height: 1.4;
}
