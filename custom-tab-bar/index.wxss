.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  display: flex;
  border-top: 2rpx solid #F0E3FA;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B8A3D9;
}

.tab-active {
  color: #9B59B6;
}

.tab-emoji-wrap {
  position: relative;
  line-height: 1;
}

.tab-emoji {
  font-size: 44rpx;
}

.tab-badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: #F06292;
  color: #FFFFFF;
  font-size: 20rpx;
  text-align: center;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}
