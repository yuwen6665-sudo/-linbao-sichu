/* 琳宝私厨 - 粉紫可爱主题 */
page {
  background: linear-gradient(180deg, #FBF3FF 0%, #FDF6FA 100%);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #4A3B5A;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(155, 89, 182, 0.08);
  border: 2rpx solid #F0E3FA;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #7A4BB5;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #7A4BB5;
  padding: 8rpx 0 16rpx 8rpx;
  display: flex;
  align-items: center;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  line-height: 84rpx;
  text-align: center;
  border: none;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, #C77DFF 0%, #9B59B6 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(155, 89, 182, 0.35);
}
.btn-primary:active { opacity: 0.85; }

.btn-pink {
  background: linear-gradient(135deg, #FF9ECD 0%, #F06292 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(240, 98, 146, 0.3);
}
.btn-pink:active { opacity: 0.85; }

.btn-outline {
  background: #FFFFFF;
  color: #9B59B6;
  border: 2rpx solid #C9A9E8;
  box-shadow: none;
}
.btn-outline:active { background: #F7EEFF; }

.btn-ghost {
  background: #F3E9FB;
  color: #8A5BB8;
  box-shadow: none;
}
.btn-ghost:active { background: #EADBF7; }

.btn-danger {
  background: #FFF0F0;
  color: #E57373;
  box-shadow: none;
}

.btn-sm {
  display: inline-block;
  font-size: 26rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  text-align: center;
  font-weight: 600;
}
.btn-sm::after { border: none; }

/* ---------- 筛选小胶囊 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 8rpx 24rpx 16rpx;
}
.chip {
  background: #FFFFFF;
  border: 2rpx solid #E8D8F7;
  color: #7A6A90;
  border-radius: 34rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
}
.chip-active {
  background: linear-gradient(135deg, #C77DFF, #9B59B6);
  border-color: #9B59B6;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  background: #F3E9FB;
  color: #8A5BB8;
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin: 0 10rpx 10rpx 0;
}
.tag-pink {
  background: #FFEDF5;
  color: #D46A9C;
}

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  color: #B8A3D9;
  padding: 80rpx 0;
  font-size: 28rpx;
}
.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #E8D8F7, transparent);
  margin: 20rpx 0;
}

/* ---------- 输入 ---------- */
.input, .textarea {
  background: #FBF7FF;
  border: 2rpx solid #E8D8F7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  color: #4A3B5A;
}
.textarea {
  min-height: 120rpx;
}

/* ---------- 底部安全区 ---------- */
.safe-bottom {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
